// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEDICO
  ENFERMERO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hash bcrypt
  nombre    String
  cmp       String?  // N° Colegiatura Médica
  rol       Role     @default(MEDICO)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relación: Un médico puede tener múltiples triajes registrados
  triajes       Triaje[]
}

model Triaje {
  id            String   @id @default(uuid())
  nombreCompleto String?
  dni           String?
  edad          Int?
  peso          Float?
  altura        Float?
  telefono      String?  // Opcional para triajes web; presente en los de WhatsApp
  sintomas      String   @db.Text
  urgencia      String
  especialidad  String
  recomendacion String   @db.Text
  fecha         DateTime @default(now())

  // Relación con el profesional de la salud que atiende/registra
  medicoId      String?
  medico        User?    @relation(fields: [medicoId], references: [id])
}