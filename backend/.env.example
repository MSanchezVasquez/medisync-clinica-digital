GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
AI_TIMEOUT_MS=45000
AI_ATTEMPT_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=4
AI_RETRY_BASE_MS=800
PORT=3000

# WAHA WhatsApp (mantén las credenciales reales en backend/.env, nunca en Git).
WAHA_BASE_URL=http://127.0.0.1:3005
WAHA_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
WAHA_SESSION=bot-medisync
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Supabase PostgreSQL. Estas variables son exclusivas del backend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Compatibilidad opcional con proyectos antiguos:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
# Prisma CLI usa esta conexión solo para aplicar migraciones.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
