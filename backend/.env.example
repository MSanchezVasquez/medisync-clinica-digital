# Copia estas variables a backend/.env para habilitar el envío de informes.
# SMTP_PORT suele ser 587 (STARTTLS) o 465 (TLS directo).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@example.com
SMTP_PASS=tu-clave-o-app-password
SMTP_FROM="MediSync Perú <tu-cuenta@example.com>"
